{
  "manifest_version": 3,
  "name": "AdMask",
  "version": "0.1.4",
  "description": "Detects ads and replaces them with a placeholder. Gives you the choice to reveal the original.",

  "permissions": [
    "storage",
    "alarms",
    "webNavigation",
    "downloads",
    "tabs",
    "contextMenus"
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "AdMask"
  },

  "host_permissions": [
    "<all_urls>"
  ],

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src https://easylist.to https://easylist-downloads.adblockplus.org"
  },

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["tracker-guard.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "world": "ISOLATED"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content-main.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
